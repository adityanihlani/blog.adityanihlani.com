---
import type { getPosts } from '../lib';
interface Props { posts: Awaited<ReturnType<typeof getPosts>> }
const { posts } = Astro.props;
---
<ul class="posts">
  {posts.map(({ post, section, slug }) => (
    <li>
      <a href={`/${section}/${slug}/`}>{post.data.title}</a>
      <span class="meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time></span>
    </li>
  ))}
</ul>
