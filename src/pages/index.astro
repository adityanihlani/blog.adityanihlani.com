---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, sections } from '../lib';

const groups = await Promise.all(
  (Object.keys(sections) as (keyof typeof sections)[]).map(async (key) => ({
    key,
    label: sections[key].label,
    posts: (await getPosts(key)).slice(0, 5),
  })),
);
---
<Base>
  {groups.map((g) => (
    <section class="group">
      <h2><a href={`/${g.key}/`}>{g.label}</a></h2>
      <PostList posts={g.posts} />
    </section>
  ))}
</Base>
